# Supabase — fuente de verdad de Listas (público, anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AEMET OpenData — pronóstico del tiempo para la boda (servidor, no público)
# Solicitar en https://opendata.aemet.es/centrodedescargas/inicio
AEMET_API_KEY=your-aemet-api-key
